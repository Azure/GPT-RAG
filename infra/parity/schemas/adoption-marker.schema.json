{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/bicep-ptn-aiml-landing-zone/schemas/parity/adoption-marker.schema.json",
  "title": "Assessment ledger adoption marker",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ledgerBranch", "integrationBranch", "adoptionCommitSha", "adoptedAt", "backfilledPullRequests", "note"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "ledgerBranch": { "const": "terraform-parity-assessments" },
    "integrationBranch": { "const": "develop" },
    "adoptionCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "adoptedAt": { "type": "string", "format": "date-time" },
    "backfilledPullRequests": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1 },
      "uniqueItems": true
    },
    "note": { "type": "string", "minLength": 1 }
  }
}
