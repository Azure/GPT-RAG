{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/bicep-ptn-aiml-landing-zone/schemas/parity/assessment.schema.json",
  "title": "Merged pull request parity assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "sourcePr", "baselineId", "changedCapabilities", "outcome", "rationale", "handoffIds", "review"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^assessment-[0-9]+-[0-9a-f]{7,40}$" },
    "sourcePr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "url", "mergeCommitSha", "baseBranch", "mergedAt"],
      "properties": {
        "repository": { "const": "Azure/bicep-ptn-aiml-landing-zone" },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "format": "uri" },
        "mergeCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "baseBranch": { "const": "develop" },
        "mergedAt": { "type": "string", "format": "date-time" }
      }
    },
    "baselineId": { "type": "string", "pattern": "^baseline-" },
    "changedCapabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }, "uniqueItems": true },
    "outcome": { "enum": ["pending", "no-terraform-impact", "inventory-update", "proposal-required", "blocked", "deferred", "superseded"] },
    "rationale": { "type": "string" },
    "evidenceLinks": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
    "handoffIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "superseded"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "approvalUrl": { "type": "string", "format": "uri" },
        "reviewedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "not": { "const": "pending" } } } },
      "then": { "properties": { "rationale": { "minLength": 1 } } }
    },
    {
      "if": { "properties": { "review": { "properties": { "status": { "enum": ["approved", "rejected"] } } } } },
      "then": { "properties": { "review": { "required": ["reviewer", "approvalUrl", "reviewedAt"] } } }
    }
  ]
}
