{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/bicep-ptn-aiml-landing-zone/schemas/parity/inventory.schema.json",
  "title": "AI Landing Zone parity inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "scenarios", "surfaceContracts", "capabilities"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "terraform", "assessedAt", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^baseline-[a-z0-9.-]+$" },
        "source": { "$ref": "#/$defs/repositoryBaseline" },
        "terraform": { "$ref": "#/$defs/repositoryBaseline" },
        "assessedAt": { "type": "string", "format": "date-time" },
        "status": { "enum": ["active", "superseded"] }
      }
    },
    "scenarios": {
      "type": "array",
      "prefixItems": [
        { "const": "standalone-standard" },
        { "const": "standalone-network-isolated" }
      ],
      "items": false
    },
    "surfaceContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "outputs", "runtimeKeys"],
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputSurface" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/outputSurface" }
        },
        "runtimeKeys": {
          "type": "array",
          "items": { "$ref": "#/$defs/runtimeKeySurface" }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" }
    }
  },
  "$defs": {
    "defaultRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation"],
          "properties": {
            "representation": { "const": "none" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "value"],
          "properties": {
            "representation": { "const": "literal" },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "expression"],
          "properties": {
            "representation": { "const": "expression" },
            "expression": { "type": "string", "pattern": "^\\[.*\\]$" }
          }
        }
      ]
    },
    "inputSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "type", "required", "default", "allowedValues"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "kind": { "const": "input" },
        "type": { "$ref": "#/$defs/typeRepresentation" },
        "required": { "type": "boolean" },
        "default": { "$ref": "#/$defs/defaultRepresentation" },
        "allowedValues": { "type": "array", "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "required": { "const": true } }, "required": ["required"] },
          "then": { "properties": { "default": { "properties": { "representation": { "const": "none" } } } } },
          "else": { "properties": { "default": { "properties": { "representation": { "enum": ["literal", "expression"] } } } } }
        }
      ]
    },
    "outputSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "type"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "kind": { "const": "output" },
        "type": { "$ref": "#/$defs/typeRepresentation" }
      }
    },
    "typeRepresentation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "name"],
          "properties": {
            "representation": { "const": "built-in" },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["representation", "ref"],
          "properties": {
            "representation": { "const": "definition" },
            "ref": { "type": "string", "pattern": "^#/definitions/[A-Za-z][A-Za-z0-9_]*$" }
          }
        }
      ]
    },
    "runtimeKeySurface": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "classification"],
          "properties": {
            "name": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "kind": { "const": "runtime-key" },
            "classification": { "const": "literal" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind", "classification", "pattern"],
          "properties": {
            "name": { "type": "string", "pattern": "^<[A-Z_]+>[A-Z0-9_]*$" },
            "kind": { "const": "runtime-key" },
            "classification": { "const": "pattern" },
            "pattern": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "repositoryBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "releaseTag", "commitSha"],
      "properties": {
        "repository": { "type": "string", "pattern": "^Azure/[A-Za-z0-9_.-]+$" },
        "releaseTag": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "scenarioAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "supportStatus", "evidenceLevel", "parityDeclared", "consumerImpact", "compatibility", "proposalIds", "evidenceIds"],
      "properties": {
        "scenario": { "enum": ["standalone-standard", "standalone-network-isolated"] },
        "supportStatus": { "enum": ["full", "partial", "absent", "blocked"] },
        "evidenceLevel": { "enum": ["static", "proposal", "merged", "deployed", "reviewed"] },
        "parityDeclared": { "type": "boolean" },
        "consumerImpact": { "type": "string" },
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["expectation", "affectedInputs", "affectedOutputs", "defaultDifferences", "migrationRequired"],
          "properties": {
            "expectation": { "enum": ["preserve", "deprecate", "break"] },
            "affectedInputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "affectedOutputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "defaultDifferences": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "migrationRequired": { "type": "boolean" }
          }
        },
        "blockedReason": { "type": "string", "minLength": 1 },
        "proposalIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      },
      "allOf": [
        {
          "if": { "properties": { "supportStatus": { "const": "blocked" } } },
          "then": { "required": ["blockedReason"] }
        },
        {
          "if": { "properties": { "parityDeclared": { "const": true } } },
          "then": { "properties": { "evidenceLevel": { "const": "reviewed" }, "evidenceIds": { "minItems": 2 } } }
        }
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "title", "description", "referenceEvidence", "terraformEvidence", "consumerSurfaces", "identityRbacAssertions", "networkAssertions", "scenarioAssessments", "owner"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "category": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "referenceEvidence": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "terraformEvidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "consumerSurfaces": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "identityRbacAssertions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "networkAssertions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "scenarioAssessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/scenarioAssessment" },
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": { "scenario": { "const": "standalone-standard" } },
                "required": ["scenario"]
              },
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {
                "type": "object",
                "properties": { "scenario": { "const": "standalone-network-isolated" } },
                "required": ["scenario"]
              },
              "minContains": 1,
              "maxContains": 1
            }
          ]
        },
        "owner": { "type": "string", "minLength": 1 }
      }
    }
  }
}
