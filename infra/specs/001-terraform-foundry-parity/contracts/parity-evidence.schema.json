{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/bicep-ptn-aiml-landing-zone/schemas/parity/parity-evidence.schema.json",
  "title": "Scenario parity evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "type", "scenario", "targetCommitSha", "recordedAt", "result", "workflowUrl", "review"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^evidence-[a-z0-9-]+$" },
    "type": { "enum": ["static-validation", "terraform-plan", "proposal", "merged-change", "scenario-deployment", "reviewed-capability-comparison"] },
    "scenario": { "enum": ["standalone-standard", "standalone-network-isolated"] },
    "targetCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "recordedAt": { "type": "string", "format": "date-time" },
    "result": { "enum": ["succeeded", "failed", "rejected"] },
    "workflowUrl": { "type": "string", "format": "uri" },
    "capabilityIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "reviewer": { "type": "string" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "approvalUrl": { "type": "string", "format": "uri" }
      }
    }
  }
}
