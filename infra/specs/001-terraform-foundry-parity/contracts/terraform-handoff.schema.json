{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Azure/bicep-ptn-aiml-landing-zone/schemas/parity/terraform-handoff.schema.json",
  "title": "Terraform coding-agent handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "provenance", "capabilityIds", "source", "target", "requiredBehavior", "compatibilityConstraints", "defaultBehavior", "migrationPlan", "scenarioAcceptance", "identityRequirements", "rbacRequirements", "networkingRequirements", "securityInvariants", "avmRequirements", "acceptanceCriteria", "evidenceRequirements", "owner", "excludedScenarios", "exclusions", "semanticVersionExpectation", "migrationRequired", "approval"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "id": { "type": "string", "pattern": "^handoff-[a-z0-9-]+$" },
    "provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "assessmentId"],
          "properties": {
            "type": { "const": "alignment-assessment" },
            "assessmentId": { "type": "string", "pattern": "^assessment-" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "baselineId", "inventoryDigest"],
          "properties": {
            "type": { "const": "baseline-inventory" },
            "baselineId": { "type": "string", "pattern": "^baseline-" },
            "inventoryDigest": {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": {
                "algorithm": { "const": "sha256" },
                "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
              }
            },
            "inventoryCommitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "inventoryReviewUrl": { "type": "string", "format": "uri" }
          }
        }
      ]
    },
    "capabilityIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
    "source": { "$ref": "#/$defs/repositoryRef" },
    "target": { "$ref": "#/$defs/repositoryRef" },
    "requiredBehavior": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "compatibilityConstraints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "defaultBehavior": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "migrationPlan": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "scenarioAcceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standalone-standard", "standalone-network-isolated"],
      "properties": {
        "standalone-standard": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "standalone-network-isolated": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "identityRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "rbacRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "networkingRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "securityInvariants": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "avmRequirements": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "acceptanceCriteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "evidenceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["standalone-standard", "standalone-network-isolated"],
      "properties": {
        "standalone-standard": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "standalone-network-isolated": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 }
      }
    },
    "semanticVersionExpectation": { "enum": ["patch", "minor", "major", "none"] },
    "migrationRequired": { "type": "boolean" },
    "excludedScenarios": { "type": "array", "prefixItems": [{ "const": "hub-spoke" }], "minItems": 1, "maxItems": 1 },
    "exclusions": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected", "superseded"] },
        "approvalUrl": { "type": "string", "format": "uri" },
        "approvedBy": { "type": "string" },
        "approvedAt": { "type": "string", "format": "date-time" }
      }
    },
    "terraformPullRequestUrl": { "type": "string", "format": "uri" }
  },
  "$defs": {
    "repositoryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commitSha"],
      "properties": {
        "repository": { "type": "string", "pattern": "^Azure/[A-Za-z0-9_.-]+$" },
        "ref": { "type": "string", "minLength": 1 },
        "commitSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "approval": { "properties": { "status": { "const": "approved" } } } } },
      "then": { "properties": { "approval": { "required": ["approvalUrl", "approvedBy", "approvedAt"] } } }
    },
    {
      "if": {
        "properties": {
          "approval": { "properties": { "status": { "const": "pending" } } },
          "provenance": { "properties": { "type": { "const": "baseline-inventory" } } }
        }
      },
      "then": {
        "properties": {
          "provenance": {
            "not": {
              "anyOf": [
                { "required": ["inventoryCommitSha"] },
                { "required": ["inventoryReviewUrl"] }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval": { "properties": { "status": { "const": "approved" } } },
          "provenance": { "properties": { "type": { "const": "baseline-inventory" } } }
        }
      },
      "then": {
        "properties": {
          "provenance": { "required": ["inventoryCommitSha", "inventoryReviewUrl"] }
        }
      }
    }
  ]
}
